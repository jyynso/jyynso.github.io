---
import Project from "./Project.astro";
import Seperator from './Seperator.astro';

const projects = [
  {
    title: "Lchsr",
    tags: ["Go", "ffmpeg", "JavaScript", "CSS"],
    description:
      "A simple local file server",
    link: "https://github.com/jyynso/lcshr",
  },
];
---

<div class="w-xs md:w-xl opacity-0 animate-fadeIn [animation-delay:0.7s]">
  <h2 class="font-archivo text-base font-semibold">Project</h2> 
	<Seperator class="my-2 md:mb-4"/>
  {projects.map((project) => <Project {...project} />)}
</div>
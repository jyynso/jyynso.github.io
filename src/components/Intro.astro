---
import FancyButton from '../components/FancyButton.astro';
import Links from '../components/Links.astro';
---
<FancyButton />
<div class="w-xs md:w-xl">
  <h1 class="my-6 font-rodin text-text text-4xl font-bold text-center md:text-5xl md:text-left opacity-0 animate-fadeIn [animation-delay:0.1s]">
    Jobert Ecawat
  </h1>

  <div class="space-y-2 font-mono">
    <p class="text-muted text-sm leading-relaxed md:text-base opacity-0 animate-fadeIn [animation-delay:0.25s]">
      Hello, I'm a 4th Year IT student @<strong>QCU</strong>.
    </p>
    <p class="text-muted text-sm leading-relaxed md:text-base opacity-0 animate-fadeIn [animation-delay:0.4s]">
      I have a keen interest in everything tech related and have a passion for learning new things.
    </p>
    <p class="text-muted text-sm leading-relaxed md:text-base opacity-0 animate-fadeIn [animation-delay:0.55s]">
      I also draw and read.
    </p>
  </div>

  <Links />
</div>
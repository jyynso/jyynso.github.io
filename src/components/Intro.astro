---
import FancyButton from '../components/FancyButton.astro';
---
<div class="w-xs mt-20 md:mt-10 md:w-xl">
  <FancyButton />
  <h1 class="my-2 font-mukta text-4xl font-semibold text-left opacity-0 animate-fadeIn [animation-delay:0.1s]">
    Jobert Ecawat
  </h1>
  <div class="space-y-2 font-mono">
    <p class="text-muted text-sm leading-relaxed opacity-0 animate-fadeIn [animation-delay:0.25s]">
      Hello, I'm a 4th Year IT student @<strong> QCU</strong>.
    </p>
    <p class="text-muted text-sm leading-relaxed opacity-0 animate-fadeIn [animation-delay:0.4s]">
      I like building things with code, exploring new technologies, and occasionally drawing and reading.
    </p>
  </div>

  
</div>
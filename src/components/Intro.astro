---
import FancyButton from '../components/FancyButton.astro';
---
<div class="md:w-xl w-sm mt-8 px-6 md:px-0">
  <FancyButton />
  <h1 class="font-archivo my-2 text-2xl font-semibold text-left opacity-0 animate-fadeIn [animation-delay:0.1s]">
    Jobert Ecawat
  </h1>
  <div>
    <p class="font-atkinson text-muted text-base leading-relaxed opacity-0 animate-fadeIn [animation-delay:0.25s]">
      Hello, I'm a 4th Year IT student @ <strong>QCU</strong>.
    </p>
    <p class="font-atkinson text-muted text-base leading-relaxed opacity-0 animate-fadeIn [animation-delay:0.4s]">
      I like building things with code, exploring new technologies, and occasionally drawing and reading.
    </p>
  </div>

  
</div>
---
import ThemeBtn from '../components/SwitchTheme.astro';
---
<div class="flex items-center gap-2 md:w-xl w-sm mb-auto py-2 px-6 md:px-0 opacity-0 animate-fadeIn [animation-delay:1s]">
	<span class="flex items-center font-plexMono text-xs gap-2 ml-auto">
		<p id="clock"></p>
		<p>GMT+8</p>
	</span>
	<ThemeBtn />
</div>

<script>
  const clock = document.getElementById('clock');
  if (clock) {
    const formatter = new Intl.DateTimeFormat('en-US', {
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
      timeZone: 'Asia/Manila',
    });
    const update = () => (clock.textContent = formatter.format(new Date()));
    update();
    setInterval(update, 30_000);
  }
</script>
---

<div class="md:w-xl w-sm px-6 md:px-0 opacity-0 animate-fadeIn [animation-delay:0.85s]">
  <h2 class="text-base font-semibold font-archivo text-muted">Stack</h2>
	<Seperator class="my-2"/>
  <div class="flex flex-wrap gap-6">
    {stack.map(({ path, name, viewBox = "0 0 256 256" }) => (
			<Tooltip text={name}>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="25"
					height="25"
					class="transition-all duration-200 hover:fill-accent hover:-translate-y-0.5 fill-muted my-2"
					viewBox={viewBox}
					set:html={path}
      	/>
			</Tooltip>
    ))}
  </div>
</div>
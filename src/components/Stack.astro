---
import Seperator from "./Seperator.astro";
import { stack } from "../data/stack-icons";
---

<div class="md:w-xl w-sm px-6 mb-8 md:px-0 opacity-0 animate-fadeIn [animation-delay:0.85s]">
	<h2 class="text-base font-semibold font-archivo text-muted">Stack</h2>
	<Seperator class="my-2" />
	<div class="flex flex-wrap gap-6">
		{stack.map(({ path, name, viewBox = "0 0 256 256" }) => (
			<div class="group relative inline-block" data-icon-item>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="20"
					height="20"
					class="transition-all duration-200 hover:fill-accent group-data-active:translate-y-0.5 not-group-data-active:hover:-translate-y-0.5 hover:-translate-y-0.5 group-data-active:fill-accent fill-muted my-2"
					viewBox={viewBox}
					set:html={path}
				/>
				<span
					data-icon-label
					class="absolute top-full left-1/2 -translate-x-1/2 z-50 whitespace-nowrap px-2.5 font-plexMono font-semibold text-[10px] tracking-[0.1em] text-text/90 pointer-events-none opacity-0 blur-[2px] [text-shadow:0_1px_3px_rgba(0,0,0,0.4)] transition-[opacity,filter] duration-200 ease-out group-hover:opacity-100 group-hover:blur-none group-data-active:opacity-100 group-data-active:blur-none"
				>
					{name}
				</span>
			</div>
		))}
	</div>
</div>

<script>
	const active = new Set<HTMLElement>();

	const clearAll = () => {
		active.forEach((item) => item.removeAttribute("data-active"));
		active.clear();
	};

	document.querySelectorAll<HTMLElement>("[data-icon-item]").forEach((item) => {
		item.addEventListener("click", (event) => {
			const wasActive = active.has(item);
			clearAll();
			if (!wasActive) {
				active.add(item);
				item.setAttribute("data-active", "");
			}
			event.stopPropagation();
		});
	});

	document.addEventListener("click", clearAll);
	window.addEventListener("blur", clearAll);
</script>

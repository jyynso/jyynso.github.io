---
interface Props {
  text: string;
}
const { text } = Astro.props;
---

<div class="group relative" data-tooltip-trigger>
  <slot />
  <span
    role="tooltip"
    data-tooltip-content
    class:list={[
      "absolute z-50 whitespace-nowrap px-2.5 py-1",
      "font-mono text-[10px] font-semibold tracking-[0.08em] text-text",
      "pointer-events-none opacity-0 scale-95",
      "transition-[opacity,transform] duration-200 ease-out",
      "group-hover:opacity-100 group-hover:scale-100",
      "group-focus-within:opacity-100 group-focus-within:scale-100",
    ]}>
    {text}
  </span>
</div>

<script>
  const suppressTooltips = () => {
    document.querySelectorAll<HTMLElement>('[data-tooltip-content]').forEach((tooltip) => {
      tooltip.dataset.suppressed = 'true';
      tooltip.style.setProperty('opacity', '0', 'important');
    });
  };

  const restoreTooltip = (tooltip: HTMLElement) => {
    delete tooltip.dataset.suppressed;
    tooltip.style.removeProperty('opacity');
  };

  const targets = new Map<HTMLElement, { x: number; y: number }>();
  const current = new Map<HTMLElement, { x: number; y: number }>();
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

  const tick = () => {
    targets.forEach((target, tooltip) => {
      const cur = current.get(tooltip)!;
      cur.x = lerp(cur.x, target.x, 0.1);
      cur.y = lerp(cur.y, target.y, 0.1);
      tooltip.style.left = `${cur.x}px`;
      tooltip.style.top = `${cur.y}px`;
    });
    requestAnimationFrame(tick);
  };
  requestAnimationFrame(tick);

  const dismissed = new WeakSet<HTMLElement>();

  document.querySelectorAll<HTMLElement>('[data-tooltip-trigger]').forEach((trigger) => {
    const tooltip = trigger.querySelector<HTMLElement>('[data-tooltip-content]');
    if (!tooltip) return;

    tooltip.style.transform = 'none';

    const dismiss = () => {
      if (dismissed.has(trigger)) return;
      dismissed.add(trigger);
      suppressTooltips();
    }

    trigger.addEventListener('pointerenter', (event) => {
      restoreTooltip(tooltip);
      const bounds = trigger.getBoundingClientRect();
      const pos = {
        x: event.clientX - bounds.left + 14,
        y: event.clientY - bounds.top + 14,
      };
      targets.set(tooltip, pos);
      current.set(tooltip, { ...pos });
    });

    trigger.addEventListener('pointermove', (event) => {
      restoreTooltip(tooltip);
      const bounds = trigger.getBoundingClientRect();
      targets.set(tooltip, {
        x: event.clientX - bounds.left + 14,
        y: event.clientY - bounds.top + 14,
      });
    });

    trigger.addEventListener('pointerleave', () => suppressTooltips());
    trigger.addEventListener('click', dismiss);
    trigger.addEventListener('focus', dismiss);
  });

  window.addEventListener('blur', suppressTooltips);
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) suppressTooltips();
  });
</script>
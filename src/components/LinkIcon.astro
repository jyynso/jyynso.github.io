---
import Tooltip from './Tooltip.astro';

interface Props {
  href: string;
  title: string;
  svgPath: string;
	viewBox?: string;
}

const { href, title, svgPath, viewBox = "0 0 256 256" } = Astro.props;
---
<Tooltip text={title}>
  <div
    class="bg-transparent cursor-pointer px-2 transition-all duration-200 hover:-translate-y-0.5">
    <a href={href} target="_blank">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="26"
        height="26"
        class="fill-muted hover:fill-accent"
        viewBox={viewBox}
        set:html={svgPath}
      />
    </a>
</div>
</Tooltip>
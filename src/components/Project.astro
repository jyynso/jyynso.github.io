---
interface Props {
  title: string;
  tags: string[];
  description: string;
  link: string;
}

const { title, tags, description, link } = Astro.props;
---

<a href={link} target="_blank" class="group block">
  <div class="my-4 p-2 -m-2 rounded transition-all duration-200 group-hover:text-accent group-hover:-translate-y-0.5 ">
    <div class="flex flex-row justify-between items-center">
      <h3 class="text-lg font-semibold font-mukta">
        {title}
      </h3>
      <div class="flex flex-row gap-2 font-mono group-hover:text-accent">
        {tags.map((tag) => <p class="text-xs font-semibold">{tag}</p>)}
      </div>
    </div>
    <p class="text-sm font-mono">{description}</p>
  </div>
</a>
---
import Tooltip from "./Tooltip.astro";

interface Props {
	title: string;
	tags: string[];
	description: string;
	link: string;
}

const { title, tags, description, link } = Astro.props;
---

<a href={link} target="_blank" class="block">
	<Tooltip text="go to repo">
		<div class="my-4 p-2 -m-2 rounded transition-all duration-200 hover:text-accent hover:-translate-y-0.5">
			<div class="flex flex-col md:flex-row md:justify-between md:items-baseline gap-x-2">
				<h3 class="font-archivo text-base text-text font-semibold group-hover:text-accent">
					{title}
				</h3>
				<div class="flex flex-row flex-wrap gap-x-2 justify-start md:justify-end md:max-w-[55%]">
					{tags.map((tag) => (
						<p class="font-plexMono text-[11px] text-xtraMuted group-hover:text-accent after:content-['·'] after:ml-2 last:after:content-none">
							{tag}
						</p>
					))}
				</div>
			</div>
			<p class="font-atkinson text-base text-muted group-hover:text-accent mt-1">
				{description}
			</p>
		</div>
	</Tooltip>
</a>

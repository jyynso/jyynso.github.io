---
interface Icon {
  path: string;
  viewBox?: string;
  type?: "fill" | "stroke";
}

interface Props {
  label: string;
  svgPaths: Icon[];
}

const { label, svgPaths } = Astro.props;
---

<div class="flex flex-col">
  <h3 class="text-sm font-mono">{label}</h3>
  <div class="flex flex-row items-center gap-2 my-2">
    {
      svgPaths.map(({ path, viewBox = "0 0 256 256", type = "fill" }) => (
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="30"
          height="30"
          class={type === "stroke" ? "stroke-muted fill-none" : "fill-muted"}
          stroke-width={type === "stroke" ? "2" : undefined}
          stroke-linecap={type === "stroke" ? "round" : undefined}
          stroke-linejoin={type === "stroke" ? "round" : undefined}
          viewBox={viewBox}
          set:html={path}
        />
      ))
    }
  </div>
</div>
<button
  id="theme-toggle"
  class="w-6 h-6 grid place-items-center text-text cursor-pointer hover:[&_svg]:fill-svgHover transition-colors"
  aria-label="Toggle theme"
>
  <svg class="icon icon-sun w-4.5 h-4.5 absolute" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 256 256">
    <path d="M120,40V32a8,8,0,0,1,16,0v8a8,8,0,0,1-16,0Zm8,24a64,64,0,1,0,64,64A64.07,64.07,0,0,0,128,64ZM58.34,69.66A8,8,0,0,0,69.66,58.34l-8-8A8,8,0,0,0,50.34,61.66Zm0,116.68-8,8a8,8,0,0,0,11.32,11.32l8-8a8,8,0,0,0-11.32-11.32ZM192,72a8,8,0,0,0,5.66-2.34l8-8a8,8,0,0,0-11.32-11.32l-8,8A8,8,0,0,0,192,72Zm5.66,114.34a8,8,0,0,0-11.32,11.32l8,8a8,8,0,0,0,11.32-11.32ZM40,120H32a8,8,0,0,0,0,16h8a8,8,0,0,0,0-16Zm88,88a8,8,0,0,0-8,8v8a8,8,0,0,0,16,0v-8A8,8,0,0,0,128,208Zm96-88h-8a8,8,0,0,0,0,16h8a8,8,0,0,0,0-16Z"/>
  </svg>
  <svg class="icon icon-moon w-4.5 h-4.5 absolute" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 256 256">
    <path d="M235.54,150.21a104.84,104.84,0,0,1-37,52.91A104,104,0,0,1,32,120,103.09,103.09,0,0,1,52.88,57.48a104.84,104.84,0,0,1,52.91-37,8,8,0,0,1,10,10,88.08,88.08,0,0,0,109.8,109.8,8,8,0,0,1,10,10Z"/>
  </svg>
</button>

<style>
  .icon { transition: opacity 0.2s ease, transform 0.3s ease; }
  .icon-moon { opacity: 0; transform: scale(0.5) rotate(-90deg); }
  .icon-sun { opacity: 1; transform: scale(1) rotate(0deg); }
  :global([data-theme="dark"]) .icon-sun { opacity: 0; transform: scale(0.5) rotate(90deg); }
  :global([data-theme="dark"]) .icon-moon { opacity: 1; transform: scale(1) rotate(0deg); }
</style>

<script>
  const toggle = document.getElementById('theme-toggle') as HTMLButtonElement | null;
  const root = document.documentElement;
  const storageKey = 'theme';

  function applyTheme(theme: string) {
    root.setAttribute('data-theme', theme);
    localStorage.setItem(storageKey, theme);
  }

  applyTheme(localStorage.getItem(storageKey) || 'light');

  toggle?.addEventListener('click', () => {
    const current = root.getAttribute('data-theme');
    applyTheme(current === 'dark' ? 'light' : 'dark');
  });
</script>
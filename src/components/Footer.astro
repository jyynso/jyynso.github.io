---
import Seperator from "./Seperator.astro";
import Links from "./LinkIcon.astro";

const links = [
  {
    href: "https://github.com/jyynso",
    title: "github",
		viewBox: "0 0 24 24",
    svgPath:
      '<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path>'
	},
  {
    href: "https://mail.google.com/mail/?view=cm&fs=1&to=ecwt26@gmail.com",
    title: "email",
    svgPath:
      '<path d="M224,48H32a8,8,0,0,0-8,8V192a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V56A8,8,0,0,0,224,48Zm-8,144H40V74.19l82.59,75.71a8,8,0,0,0,10.82,0L216,74.19V192Z"></path>'
		},
  {
    href: "https://www.linkedin.com/in/jobert-ecawat",
    title: "linkedin",
		viewBox: "0 0 448 512",
    svgPath:
      '<path d="M416 32H31.9C14.3 32 0 46.5 0 64.3v383.4C0 465.5 14.3 480 31.9 480H416c17.6 0 32-14.5 32-32.3V64.3c0-17.8-14.4-32.3-32-32.3zM135.4 416H69V202.2h66.5V416zm-33.2-243c-21.3 0-38.5-17.3-38.5-38.5S80.9 96 102.2 96c21.2 0 38.5 17.3 38.5 38.5 0 21.3-17.2 38.5-38.5 38.5zm282.1 243h-66.4V312c0-24.8-.5-56.7-34.5-56.7-34.6 0-39.9 27-39.9 54.9V416h-66.4V202.2h63.7v29.2h.9c8.9-16.8 30.6-34.5 62.9-34.5 67.2 0 79.7 44.3 79.7 101.9V416z"></path>'
	},
];
---

<div class="mt-auto pb-8 w-xs md:w-xl opacity-0 animate-fadeIn [animation-delay:1s]">
  <Seperator class="my-2 md:mb-4"/>
  <div class="flex flex-col-reverse gap-4 md:flex-row md:items-center justify-between">
    <div
			class="flex flex-row gap-2"
			id="links">
			{links.map((link) => <Links {...link} />)}
  	</div>
    <div id="now-playing" class="flex max-w-90 items-center gap-2 text-sm text-muted">
      <svg 
        width="18" 
        height="18" 
        class="fill-text"
        viewBox="0 0 256 256"><path d="M201.89,54.66A103.43,103.43,0,0,0,128.79,24H128A104,104,0,0,0,24,128v56a24,24,0,0,0,24,24H64a24,24,0,0,0,24-24V144a24,24,0,0,0-24-24H40.36A88,88,0,0,1,128,40h.67a87.71,87.71,0,0,1,87,80H192a24,24,0,0,0-24,24v40a24,24,0,0,0,24,24h16a24,24,0,0,0,24-24V128A103.41,103.41,0,0,0,201.89,54.66ZM64,136a8,8,0,0,1,8,8v40a8,8,0,0,1-8,8H48a8,8,0,0,1-8-8V136Zm152,48a8,8,0,0,1-8,8H192a8,8,0,0,1-8-8V144a8,8,0,0,1,8-8h24Z"></path>
      </svg>
    </div>
  </div>
</div>

<script>
  fetch("https://spot-api-orcin.vercel.app/api/nowPlaying")
    .then(res => res.json())
    .then(data => {
			const el = document.getElementById("now-playing");
			if (!el) return;

			const noteIcon = `<svg 
				width="18" 
				height="18" 
				class="fill-current"
				viewBox="0 0 256 256"><path d="M232,128v56a24,24,0,0,1-24,24H192a24,24,0,0,1-24-24V144a24,24,0,0,1,24-24h23.65a87.71,87.71,0,0,0-87-80H128a88,88,0,0,0-87.64,80H64a24,24,0,0,1,24,24v40a24,24,0,0,1-24,24H48a24,24,0,0,1-24-24V128A104.11,104.11,0,0,1,201.89,54.66,103.41,103.41,0,0,1,232,128Z"></path>
				</svg>`;

			if (data.isPlaying) {
				el.innerHTML = `
				<a href="${data.songUrl}" target="_blank" rel="noopener noreferrer" class="font-plexMono text-xs flex flex-row items-center gap-2 min-w-0 hover:text-accent transition-colors">
						${noteIcon}
						<span class="truncate">
							<span class="font-bold">${data.title}</span>
							·
							${data.artist}
						</span>
					</a>
				`;
			} else {
				el.innerHTML = noteIcon;
			}	
    })
    .catch(() => {
      const el = document.getElementById("now-playing");
      if (el) el.textContent = "";
    });
</script>
---
interface Props {
  href: string;
  title: string;
  svgPath: string;
}

const { href, title, svgPath } = Astro.props;
---

<div
  class="bg-transparent cursor-pointer px-1.5 py-1.5 rounded-lg transition-all duration-200 select-none hover:bg-[color-mix(in_srgb,var(--accent)_40%,transparent)] hover:-translate-y-0.5"
  draggable="true"
>
  <a href={href} target="_blank" title={title}>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="30"
      height="30"
      class="fill-muted"
      viewBox="0 0 256 256"
      set:html={svgPath}
    />
  </a>
</div>